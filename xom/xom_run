#!/usr/bin/env bash

XOM_PATH=${BASH_SOURCE[0]}
XOM_HOME=$(dirname "$XOM_PATH")
XOM_HOME=$(realpath "$XOM_HOME")
MPK_XOM_LIB="$XOM_HOME/libmpk_xom.so"

if [ ! -f "$MPK_XOM_LIB" ]; then
    echo "[xom-run] missing library: $MPK_XOM_LIB" >&2
    exit 124
fi

export MPK_XOM_SCOPE="${MPK_XOM_SCOPE:-main}"
export MPK_XOM_VERBOSE="${MPK_XOM_VERBOSE:-0}"

if [ -n "${LD_PRELOAD:-}" ]; then
    export LD_PRELOAD="$MPK_XOM_LIB:$LD_PRELOAD"
else
    export LD_PRELOAD="$MPK_XOM_LIB"
fi

exec "$@"