prefix=/root/AsmXoM/evaluation/openssl-3.3.5/build
exec_prefix=${prefix}
libdir=${exec_prefix}/lib64
includedir=${prefix}/include 

Name: OpenSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 3.3.5
Requires.private: libcrypto
Libs: -L${libdir} -lssl
Cflags: -I${includedir}
