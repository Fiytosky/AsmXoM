static int script_39_inject_plain(struct helper *h, QUIC_PKT_HDR *hdr,
                                  unsigned char *buf, size_t len)
{
    int ok = 0;
    WPACKET wpkt;
    unsigned char frame_buf[64];
    size_t i, written;
    uint64_t seq_no = 0, retire_prior_to = 0;
    QUIC_CONN_ID new_cid = {0};
    QUIC_CHANNEL *ch = ossl_quic_tserver_get_channel(h->s_priv);

    if (hdr->type != 5)
        return 1;

    switch (h->inject_word1) {
    case 0:
        return 1;
    case 1:
        new_cid.id_len = 0;
        break;
    case 2:
        new_cid.id_len = 21;
        break;
    case 3:
        new_cid.id_len = 1;
        new_cid.id[0] = 0x55;

        seq_no = 0;
        retire_prior_to = 1;
        break;
    case 4:

        ossl_quic_channel_get_diag_local_cid(ch, &new_cid);

        seq_no = 2;
        retire_prior_to = 2;
        break;
    case 5:




        new_cid.id_len = 8;
        new_cid.id[0] = 0x55;

        seq_no = 1;
        retire_prior_to = 1;
        break;
    }

    if (!test_true("../test/quic_multistream_test.c", 3489, "WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)", (WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)) != 0)
                                                                 )
        return 0;

    if (!test_true("../test/quic_multistream_test.c", 3493, "WPACKET_quic_write_vlint(&wpkt, OSSL_QUIC_FRAME_TYPE_NEW_CONN_ID)", (WPACKET_quic_write_vlint(&wpkt, 0x18)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3494, "WPACKET_quic_write_vlint(&wpkt, seq_no)", (WPACKET_quic_write_vlint(&wpkt, seq_no)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3495, "WPACKET_quic_write_vlint(&wpkt, retire_prior_to)", (WPACKET_quic_write_vlint(&wpkt, retire_prior_to)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3496, "WPACKET_put_bytes_u8(&wpkt, new_cid.id_len)", (WPACKET_put_bytes__((&wpkt), (new_cid.id_len), 1)) != 0))
        goto err;

    for (i = 0; i < new_cid.id_len && i < (sizeof(new_cid.id)/sizeof((new_cid.id)[0])); ++i)
        if (!test_true("../test/quic_multistream_test.c", 3500, "WPACKET_put_bytes_u8(&wpkt, new_cid.id[i])", (WPACKET_put_bytes__((&wpkt), (new_cid.id[i]), 1)) != 0))
            goto err;

    for (; i < new_cid.id_len; ++i)
        if (!test_true("../test/quic_multistream_test.c", 3504, "WPACKET_put_bytes_u8(&wpkt, 0x55)", (WPACKET_put_bytes__((&wpkt), (0x55), 1)) != 0))
            goto err;

    for (i = 0; i < 16; ++i)
        if (!test_true("../test/quic_multistream_test.c", 3508, "WPACKET_put_bytes_u8(&wpkt, 0x42)", (WPACKET_put_bytes__((&wpkt), (0x42), 1)) != 0))
            goto err;

    if (!test_true("../test/quic_multistream_test.c", 3511, "WPACKET_get_total_written(&wpkt, &written)", (WPACKET_get_total_written(&wpkt, &written)) != 0))
        goto err;

    if (!qtest_fault_prepend_frame(h->qtf, frame_buf, written))
        goto err;

    ok = 1;
err:
    if (ok)
        WPACKET_finish(&wpkt);
    else
        WPACKET_cleanup(&wpkt);
    return ok;
}

