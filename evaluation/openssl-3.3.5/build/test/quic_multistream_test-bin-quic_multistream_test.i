static int script_28_inject_plain(struct helper *h, QUIC_PKT_HDR *hdr,
                                  unsigned char *buf, size_t len)
{
    int ok = 0;
    WPACKET wpkt;
    unsigned char frame_buf[32];
    size_t written;

    if (h->inject_word0 == 0 || hdr->type != 5)
        return 1;

    if (!test_true("../test/quic_multistream_test.c", 3101, "WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)", (WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)) != 0)
                                                                 )
        return 0;

    if (!test_true("../test/quic_multistream_test.c", 3105, "WPACKET_quic_write_vlint(&wpkt, h->inject_word1)", (WPACKET_quic_write_vlint(&wpkt, h->inject_word1)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3106, "WPACKET_quic_write_vlint(&wpkt, h->inject_word0 - 1)", (WPACKET_quic_write_vlint(&wpkt, h->inject_word0 - 1)) != 0)

        || !test_true("../test/quic_multistream_test.c", 3108, "WPACKET_quic_write_vlint(&wpkt, 123)", (WPACKET_quic_write_vlint(&wpkt, 123)) != 0)
        || (h->inject_word1 == 0x04
           && !test_true("../test/quic_multistream_test.c", 3110, "WPACKET_quic_write_vlint(&wpkt, 5)", (WPACKET_quic_write_vlint(&wpkt, 5)) != 0)))
        goto err;

    if (!test_true("../test/quic_multistream_test.c", 3113, "WPACKET_get_total_written(&wpkt, &written)", (WPACKET_get_total_written(&wpkt, &written)) != 0))
        goto err;

    if (!qtest_fault_prepend_frame(h->qtf, frame_buf, written))
        goto err;

    ok = 1;
err:
    if (ok)
        WPACKET_finish(&wpkt);
    else
        WPACKET_cleanup(&wpkt);
    return ok;
}

