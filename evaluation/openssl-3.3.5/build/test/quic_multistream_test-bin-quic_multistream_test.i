static int script_68_inject_handshake(struct helper *h, unsigned char *msg,
                                      size_t msglen)
{
    const unsigned char *data;
    size_t datalen;
    const unsigned char certreq[] = {
        13,
        0, 0, 12,
        1, 1,
        0, 8,
        0, 13,
        0, 4,
        0, 2,
        8, 4
    };
    const unsigned char keyupdate[] = {
        24,
        0, 0, 1,
        0
    };


    switch(h->inject_word0) {
    case 0:
        return 1;

    case 1:

        data = certreq;
        datalen = sizeof(certreq);
        break;

    case 2:

        data = keyupdate;
        datalen = sizeof(keyupdate);
        break;

    default:
        return 0;
    }

    if (!test_true("../test/quic_multistream_test.c", 4785, "qtest_fault_resize_message(h->qtf, datalen - SSL3_HM_HEADER_LENGTH)", (qtest_fault_resize_message(h->qtf, datalen - 4)) != 0)
                                                                               )
        return 0;

    memcpy(msg, data, datalen);

    return 1;
}


