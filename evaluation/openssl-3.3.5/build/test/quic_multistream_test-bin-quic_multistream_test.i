static const uint64_t path_challenge = 0xbdeb9451169c83aaUL;

static int script_41_inject_plain(struct helper *h, QUIC_PKT_HDR *hdr,
                                  unsigned char *buf, size_t len)
{
    int ok = 0;
    WPACKET wpkt;
    unsigned char frame_buf[16];
    size_t written;

    if (h->inject_word0 == 0 || hdr->type != 5)
        return 1;

    if (!test_true("../test/quic_multistream_test.c", 3599, "WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)", (WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)) != 0)
                                                                 )
        return 0;

    if (!test_true("../test/quic_multistream_test.c", 3603, "WPACKET_quic_write_vlint(&wpkt, h->inject_word1)", (WPACKET_quic_write_vlint(&wpkt, h->inject_word1)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3604, "WPACKET_put_bytes_u64(&wpkt, path_challenge)", (WPACKET_put_bytes__((&wpkt), (path_challenge), 8)) != 0))
        goto err;

    if (!test_true("../test/quic_multistream_test.c", 3607, "WPACKET_get_total_written(&wpkt, &written)", (WPACKET_get_total_written(&wpkt, &written)) != 0)
        || !test_size_t_eq("../test/quic_multistream_test.c", 3608, "written", "9", written, 9))
        goto err;

    if (!qtest_fault_prepend_frame(h->qtf, frame_buf, written))
        goto err;

    --h->inject_word0;
    ok = 1;
err:
    if (ok)
        WPACKET_finish(&wpkt);
    else
        WPACKET_cleanup(&wpkt);
    return ok;
}

static void script_41_trace(int write_p, int version, int content_type,
                            const void *buf, size_t len, SSL *ssl, void *arg)
{
    uint64_t frame_type, frame_data;
    int was_minimal;
    struct helper *h = arg;
    PACKET pkt;

    if (version != 0x0000001
        || content_type != 0x202
        || len < 1)
        return;

    if (!test_true("../test/quic_multistream_test.c", 3637, "PACKET_buf_init(&pkt, buf, len)", (PACKET_buf_init(&pkt, buf, len)) != 0)) {
        ++h->scratch1;
        return;
    }

    if (!test_true("../test/quic_multistream_test.c", 3642, "ossl_quic_wire_peek_frame_header(&pkt, &frame_type, &was_minimal)", (ossl_quic_wire_peek_frame_header(&pkt, &frame_type, &was_minimal)) != 0)
                                                                  ) {
        ++h->scratch1;
        return;
    }

    if (frame_type != 0x1B)
        return;

   if (!test_true("../test/quic_multistream_test.c", 3651, "ossl_quic_wire_decode_frame_path_response(&pkt, &frame_data)", (ossl_quic_wire_decode_frame_path_response(&pkt, &frame_data)) != 0)
       || !test_uint64_t_eq("../test/quic_multistream_test.c", 3652, "frame_data", "path_challenge", frame_data, path_challenge)) {
       ++h->scratch1;
        return;
   }

   ++h->scratch0;
}

static int script_41_setup(struct helper *h, struct helper_local *hl)
{
    ossl_quic_tserver_set_msg_callback(s_lock(h, hl), script_41_trace, h);
    return 1;
}

static int script_41_check(struct helper *h, struct helper_local *hl)
{

    if (!test_uint64_t_gt("../test/quic_multistream_test.c", 3669, "h->scratch0", "0", h->scratch0, 0))
        return 0;


    if (!test_uint64_t_eq("../test/quic_multistream_test.c", 3673, "h->scratch1", "0", h->scratch1, 0))
        return 0;

    return 1;
}

