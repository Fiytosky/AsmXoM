static int script_32_inject_plain(struct helper *h, QUIC_PKT_HDR *hdr,
                                  unsigned char *buf, size_t len)
{
    int ok = 0;
    WPACKET wpkt;
    unsigned char frame_buf[64];
    size_t written;
    uint64_t type = (0x08 | 0x04 | 0x02), offset, flen, i;

    if (hdr->type != 5)
        return 1;

    switch (h->inject_word1) {
    default:
        return 0;
    case 0:
        return 1;
    case 1:
        offset = 0;
        flen = 0;
        break;
    case 2:
        offset = (((uint64_t)1)<<62) - 1;
        flen = 5;
        break;
    case 3:
        offset = 1 * 1024 * 1024 * 1024;
        flen = 5;
        break;
    case 4:
        offset = 0;
        flen = 1;
        break;
    }

    if (!test_true("../test/quic_multistream_test.c", 3259, "WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)", (WPACKET_init_static_len(&wpkt, frame_buf, sizeof(frame_buf), 0)) != 0)
                                                                 )
        return 0;

    if (!test_true("../test/quic_multistream_test.c", 3263, "WPACKET_quic_write_vlint(&wpkt, type)", (WPACKET_quic_write_vlint(&wpkt, type)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3264, "WPACKET_quic_write_vlint(&wpkt, h->inject_word0 - 1)", (WPACKET_quic_write_vlint(&wpkt, h->inject_word0 - 1)) != 0)

        || !test_true("../test/quic_multistream_test.c", 3266, "WPACKET_quic_write_vlint(&wpkt, offset)", (WPACKET_quic_write_vlint(&wpkt, offset)) != 0)
        || !test_true("../test/quic_multistream_test.c", 3267, "WPACKET_quic_write_vlint(&wpkt, flen)", (WPACKET_quic_write_vlint(&wpkt, flen)) != 0))
        goto err;

    for (i = 0; i < flen; ++i)
        if (!test_true("../test/quic_multistream_test.c", 3271, "WPACKET_put_bytes_u8(&wpkt, 0x42)", (WPACKET_put_bytes__((&wpkt), (0x42), 1)) != 0))
            goto err;

    if (!test_true("../test/quic_multistream_test.c", 3274, "WPACKET_get_total_written(&wpkt, &written)", (WPACKET_get_total_written(&wpkt, &written)) != 0))
        goto err;

    if (!qtest_fault_prepend_frame(h->qtf, frame_buf, written))
        goto err;

    ok = 1;
err:
    if (ok)
        WPACKET_finish(&wpkt);
    else
        WPACKET_cleanup(&wpkt);
    return ok;
}

