#!/usr/bin/env bash

# =================== Configure ==================
REAL_GXX="$GXX_PATH"
TARGET_LOG_DIR="$ASMXOM_HOME/workspace/compiler-info"

CURRENT_PATH=$(pwd)
CURRENT_DIR_NAME=$(basename "$CURRENT_PATH")

if [ -n "$ASM_STATS_DIR" ]; then
    PROJECT_NAME=$(basename "$(dirname "$ASM_STATS_DIR")")
else
    if [ "$CURRENT_DIR_NAME" == "build" ]; then
        #  A: path is .../libgcrypto-1.8.12/build
        PROJECT_NAME=$(basename "$(dirname "$CURRENT_PATH")")
    else
        # B: path is .../libgcrypto-1.8.12
        PROJECT_NAME="$CURRENT_DIR_NAME"
    fi
fi
LOG_FILE="${TARGET_LOG_DIR}/${PROJECT_NAME}_asm_stats.log"
LOG_CMD_FILE="${TARGET_LOG_DIR}/${PROJECT_NAME}_gcc_commands.log"
touch "$LOG_FILE"
touch "$LOG_CMD_FILE"

# filter irrelevant target
should_log_file() {
    local file_path="$1"

    # 1. filter dummy.c (generated by libtool)
    if [[ "$file_path" == *".libs/dummy.c"* ]]; then
        return 1
    fi

    # 2. filter /tmp/ (temporary file)
    if [[ "$file_path" == *"/tmp/"* ]]; then
        return 1
    fi

    # 3. filter test/examples
    # conftest: temporary test files generated by the configure script
    # /test/, /tests/: unit test directories
    # /demo/, /examples/: example code
    # /check/: test directories used by some projects
    if [[ "$file_path" == *"conftest"* ]] || \
       [[ "$file_path" == *"/test/"* ]] || \
       [[ "$file_path" == *"/tests/"* ]] || \
       [[ "$file_path" == *"/demo/"* ]] || \
       [[ "$file_path" == *"/examples/"* ]] || \
       [[ "$file_path" == *"/check/"* ]]; then
        return 1 # Skip
    fi
    
    return 0 # Keep
}

for arg in "$@"; do
    # 1. .s is generated by compiler
    if [[ "$arg" == *.c ]] || [[ "$arg" == *.cc ]] || [[ "$arg" == *.cpp ]]; then
        if should_log_file "$arg"; then
            echo "[Compiler Generated] $arg" >> "$LOG_FILE"
            echo "$REAL_GXX $(printf " %q" "$@")" >> "$LOG_CMD_FILE"
        fi
    fi

    # 2. .s is generated by developer/tools
    if [[ "$arg" == *.s ]] || [[ "$arg" == *.S ]]; then
        if should_log_file "$arg"; then
            echo "[Developer/Tool Generated] $arg" >> "$LOG_FILE"
            echo "$REAL_GXX $(printf " %q" "$@")" >> "$LOG_CMD_FILE"
        fi
    fi
done

# run real g++
exec "$REAL_GXX" "$@"
