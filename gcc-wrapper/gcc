#!/usr/bin/env bash

# =================== Configure ==================
REAL_GCC="$GCC_PATH"

TARGET_LOG_DIR="$ASMXOM_HOME/workspace/compiler-info"

# Use the physical path so the current directory contains no symlinks or relative components.
CURRENT_PATH="$(pwd -P)"
CURRENT_DIR_NAME="$(basename "$CURRENT_PATH")"

mkdir -p "$TARGET_LOG_DIR"

if [[ -n "${ASM_STATS_DIR:-}" ]]; then
    PROJECT_NAME="$(basename "$(dirname "$ASM_STATS_DIR")")"
else
    if [[ "$CURRENT_DIR_NAME" == "build" ]]; then
        # Case A: the current path is .../libgcrypt-1.8.12/build
        PROJECT_NAME="$(basename "$(dirname "$CURRENT_PATH")")"
    else
        # Case B: the current path is .../libgcrypt-1.8.12
        PROJECT_NAME="$CURRENT_DIR_NAME"
    fi
fi

LOG_FILE="${TARGET_LOG_DIR}/${PROJECT_NAME}_asm_stats.log"
LOG_CMD_FILE="${TARGET_LOG_DIR}/${PROJECT_NAME}_gcc_commands.log"

touch "$LOG_FILE"
touch "$LOG_CMD_FILE"


# ================= Path resolution ================

# Convert file paths in GCC arguments to normalized absolute paths.
#
# Examples:
#   ../cipher/foo.c
#   ../../cipher/foo.c
#   ./cipher/foo.c
#
# All paths are resolved relative to CURRENT_PATH at the time the GCC wrapper is invoked.
resolve_absolute_path() {
    local input_path="$1"
    local candidate_path
    local resolved_path

    if [[ "$input_path" == /* ]]; then
        # The argument is already an absolute path.
        candidate_path="$input_path"
    else
        # Resolve it relative to the working directory of the current GCC command.
        candidate_path="${CURRENT_PATH}/${input_path}"
    fi

    # Use -e when the file exists to resolve symlinks and require an existing path.
    if resolved_path="$(realpath -e -- "$candidate_path" 2>/dev/null)"; then
        printf '%s\n' "$resolved_path"
        return 0
    fi

    # Fall back to -m:
    # normalize ".", "..", and repeated "/" components even if the file does not yet exist.
    if resolved_path="$(realpath -m -- "$candidate_path" 2>/dev/null)"; then
        printf '%s\n' "$resolved_path"
        return 0
    fi

    # If realpath is unavailable or resolution fails, at least construct an absolute path.
    printf '%s\n' "$candidate_path"
}


# =================== File filter ==================

should_log_file() {
    local file_path="$1"

    # file_path should already be an absolute path at this point.

    # 1. Filter out dummy.c generated by libtool.
    if [[ "$file_path" == *"/.libs/dummy.c" ]]; then
        return 1
    fi

    # 2. Filter out temporary files under /tmp.
#
    # Note: TARGET_LOG_DIR is under /root/xom/test/tmp, not /tmp,
    # so this rule will not filter it out by mistake.
    if [[ "$file_path" == /tmp/* ]]; then
        return 1
    fi

    # 3. Filter out temporary test files generated by configure.
    if [[ "$(basename "$file_path")" == conftest* ]]; then
        return 1
    fi

    # 4. Filter out test, example, and check programs.
    if [[ "$file_path" == *"/test/"* ]]     || \
       [[ "$file_path" == *"/tests/"* ]]    || \
       [[ "$file_path" == *"/demo/"* ]]     || \
       [[ "$file_path" == *"/demos/"* ]]    || \
       [[ "$file_path" == *"/example/"* ]]  || \
       [[ "$file_path" == *"/examples/"* ]] || \
       [[ "$file_path" == *"/check/"* ]]; then
        return 1
    fi

    return 0
}


# ================ GCC argument parsing ============

# Avoid treating output files such as -o output.s and -MF dependency.d as compilation inputs.
skip_next_argument=0
should_log_command=0

for arg in "$@"; do
    if (( skip_next_argument )); then
        skip_next_argument=0
        continue
    fi

    case "$arg" in
        # The next argument is an option value, not a source input.
        -o|-MF|-MT|-MQ|-include|-imacros|-isystem|-iquote|-I|-L)
            skip_next_argument=1
            continue
            ;;

        # Combined option forms, such as -MFfoo.d and -I/path.
        -o?*|-MF?*|-MT?*|-MQ?*|-include?*|-imacros?*|-isystem?*|-iquote?*|-I?*|-L?*)
            continue
            ;;

        # Other GCC options.
        -*)
            continue
            ;;
    esac

    absolute_path="$(resolve_absolute_path "$arg")"

    # 1. C/C++ files actually used as compilation inputs.
    case "$arg" in
        *.c|*.cc|*.cpp|*.cxx|*.c++|*.C)
            if should_log_file "$absolute_path"; then
                printf '[Compiler Generated] %s\n' \
                    "$absolute_path" >> "$LOG_FILE"

                should_log_command=1
            fi
            continue
            ;;
    esac

    # 2. Standalone assembly inputs written by developers or generated by build tools.
    case "$arg" in
        *.s|*.S|*.asm)
            if should_log_file "$absolute_path"; then
                printf '[Developer/Tool Generated] %s\n' \
                    "$absolute_path" >> "$LOG_FILE"

                should_log_command=1
            fi
            continue
            ;;
    esac
done


# Log each complete GCC invocation only once to avoid duplicates when one command has multiple source files.
if (( should_log_command )); then
    {
        printf '%q' "$REAL_GCC"

        for arg in "$@"; do
            printf ' %q' "$arg"
        done

        printf '\n'
    } >> "$LOG_CMD_FILE"
fi


# ================= Run real GCC ===================

exec "$REAL_GCC" "$@"
